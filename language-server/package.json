{
  "name": "blitz-language-server",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "blitz-language-server": "./dist/src/lsp.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src test --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "vscode-languageserver": "10.1.0",
    "vscode-languageserver-textdocument": "1.0.12"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14"
}
