{
  "name": "@blitz/effect-assets",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "generate:effect": "node --experimental-strip-types scripts/generate.ts",
    "generate:stdlib": "node --experimental-strip-types scripts/generate-stdlib.ts",
    "generate:bundle": "cargo run --manifest-path ../../Cargo.toml -p blitz-cli -- precompile runtime",
    "generate": "pnpm run generate:effect && pnpm run generate:stdlib && pnpm run generate:bundle",
    "verify:effect": "node --experimental-strip-types scripts/verify.ts",
    "verify:stdlib": "node --experimental-strip-types scripts/verify-stdlib.ts",
    "verify:node-compat": "node --experimental-strip-types scripts/verify-node-compat.ts",
    "verify:bundle-bootstrap": "sh scripts/verify-bundle-bootstrap.sh",
    "verify:bundle": "cargo run --manifest-path ../../Cargo.toml -p blitz-cli -- precompile runtime --check",
    "verify": "pnpm run verify:effect && pnpm run verify:stdlib && pnpm run verify:node-compat && pnpm run verify:bundle-bootstrap && pnpm run verify:bundle",
    "typecheck:effect": "tsc -p fixtures/tsconfig.effect-foundation.json",
    "typecheck": "tsc --noEmit && pnpm run typecheck:effect",
    "test:effect": "node --experimental-strip-types scripts/test.ts",
    "test:effect-v4": "node --experimental-strip-types scripts/test-effect-v4.ts",
    "test:stdlib": "node --experimental-strip-types scripts/test-stdlib.ts",
    "test:punycode": "node --experimental-strip-types scripts/test-punycode.ts",
    "test:string-decoder": "node --experimental-strip-types scripts/test-string-decoder.ts",
    "test:async-hooks": "node --experimental-strip-types scripts/test-async-hooks.ts",
    "test:buffer": "node --experimental-strip-types scripts/test-buffer.ts",
    "test:node-roots": "node --experimental-strip-types scripts/test-node-roots.ts",
    "test:readline": "node --experimental-strip-types scripts/test-readline.ts",
    "test:streams": "node --experimental-strip-types scripts/test-node-streams.ts",
    "test:facade-gc": "node --expose-gc scripts/test-facade-gc.mjs",
    "test": "pnpm run test:effect && pnpm run test:stdlib && pnpm run test:punycode && pnpm run test:string-decoder && pnpm run test:async-hooks && pnpm run test:buffer && pnpm run test:node-roots && pnpm run test:streams && pnpm run test:readline && pnpm run test:facade-gc"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "effect": "3.22.1",
    "effect-v4": "npm:effect@4.0.0-rc.112",
    "esbuild": "0.28.2",
    "rollup": "4.63.1",
    "typescript": "7.0.2",
    "typescript-compiler": "npm:typescript@6.0.3"
  }
}
