{
  "name": "blitz-helpdesk",
  "private": true,
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check:api": "cargo run --manifest-path ../../Cargo.toml -p blitz-cli -- check --strict src/main.ts test/service.test.ts",
    "test:api": "cargo run --manifest-path ../../Cargo.toml -p blitz-cli -- run test/service.test.ts",
    "api": "cargo run --manifest-path ../../Cargo.toml -p blitz-cli -- run src/main.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}