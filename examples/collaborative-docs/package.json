{
  "name": "collaborative-docs",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "turbo run dev:api dev:web",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "cargo run --manifest-path ../../Cargo.toml -p blitz-cli -- run src/server.ts",
    "typecheck": "tsc --noEmit",
    "check:api": "cargo run --manifest-path ../../Cargo.toml -p blitz-cli -- check --strict src/server.ts test/sync.test.ts",
    "test:api": "cargo run --manifest-path ../../Cargo.toml -p blitz-cli -- run test/sync.test.ts",
    "api": "cargo run --manifest-path ../../Cargo.toml -p blitz-cli -- run src/server.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turndown": "^7.2.4"
  }
}
